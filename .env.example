# --- Database ---
DATABASE_URL=postgresql+asyncpg://pricetracker:change_me@db:5432/pricetracker
POSTGRES_USER=pricetracker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pricetracker

# --- Telegram alerts (токен бота от @BotFather, можно оставить пустым) ---
ALERT_BOT_TOKEN=

# --- Email alerts (SMTP, опционально — без SMTP_HOST письма выключены) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- Scheduler (Celery + Redis) ---
SCHEDULER_INTERVAL_MINUTES=180
ALERT_COOLDOWN_HOURS=24
REDIS_URL=redis://redis:6379/0

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Секрет для подписи сессионных cookie (сменить в проде!)
SECRET_KEY=dev-secret-change-me
